# Copy to staging.tfvars (git-ignored) and replace the placeholders. Everything here is fictional.
region     = "eu-west-1"
account_id = "000000000000"
azs        = ["eu-west-1a", "eu-west-1b"]

web_host   = "staging.example.com"
admin_host = "admin.staging.example.com"

alb_certificate_arn        = "arn:aws:acm:eu-west-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"

# aws ec2 describe-managed-prefix-lists --filters Name=prefix-list-name,Values=com.amazonaws.global.cloudfront.origin-facing
cloudfront_prefix_list_id = "pl-00000000"

# IPv4 CIDRs (office or VPN) allowed to open the admin hostname. Empty = blocked for everyone.
admin_allowed_cidrs = ["203.0.113.0/24"]

github_repo       = "arx-studios/arx-kyro"
state_bucket_name = "REPLACE-ME-kyro-tfstate-000000000000"

# Must stay 1 (see variable validation): in-memory sessions and rate limits.
api_desired_count = 1

image_tag = "bootstrap"

enable_ses = false

# KYRO local environment (sandbox only; fictional data, no real money).
# application.yml gives each API variable this local default, so a .env is optional.

# --- API ---
SPRING_PROFILES_ACTIVE=local
KYRO_DB_URL=jdbc:postgresql://localhost:5433/kyro
KYRO_DB_USER=kyro
KYRO_DB_PASSWORD=kyro_local
KYRO_S3_ENDPOINT=http://localhost:9000
KYRO_S3_PUBLIC_ENDPOINT=http://localhost:9000
KYRO_S3_REGION=us-east-1
KYRO_S3_ACCESS_KEY=kyro-minio
KYRO_S3_SECRET_KEY=kyro-minio-secret
KYRO_S3_DOCUMENTS_BUCKET=kyro-documents-local
KYRO_MAIL_HOST=localhost
KYRO_MAIL_PORT=1025
KYRO_MAIL_FROM=no-reply@kyro.local
KYRO_WEB_BASE_URL=http://localhost:3000
KYRO_POLICY_TERMS_VERSION=2026-11-01
KYRO_POLICY_PRIVACY_VERSION=2026-11-01
# true in profile "local", false otherwise
KYRO_SEED_ENABLED=true
KYRO_SEED_PASSWORD=KyroLocal!2026

# --- Web (3000) and Admin (3001): server-side only, used by Next rewrites ---
KYRO_API_ORIGIN=http://localhost:8080

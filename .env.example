# KYRO local environment (sandbox only; fictional data, no real money).
# application.yml gives each API variable this local default, so a .env is optional.

# --- API ---
SPRING_PROFILES_ACTIVE=local
KYRO_DB_URL=jdbc:postgresql://localhost:5433/kyro
KYRO_DB_USER=kyro
KYRO_DB_PASSWORD=kyro_local
KYRO_S3_ENDPOINT=http://localhost:9000
KYRO_S3_PUBLIC_ENDPOINT=http://localhost:9000
KYRO_S3_REGION=us-east-1
KYRO_S3_ACCESS_KEY=kyro-minio
KYRO_S3_SECRET_KEY=kyro-minio-secret
KYRO_S3_DOCUMENTS_BUCKET=kyro-documents-local
KYRO_MAIL_HOST=localhost
KYRO_MAIL_PORT=1025
KYRO_MAIL_FROM=no-reply@kyro.local
KYRO_WEB_BASE_URL=http://localhost:3000
KYRO_POLICY_TERMS_VERSION=2026-11-01
KYRO_POLICY_PRIVACY_VERSION=2026-11-01
# true in profile "local", false otherwise
KYRO_SEED_ENABLED=true
KYRO_SEED_PASSWORD=KyroLocal!2026

# --- Phase 5 (all optional; defaults live in application.yml) ---
# Send status-change emails to recipients
KYRO_NOTIFICATIONS_EMAIL_ENABLED=true
# Require TOTP MFA for /admin/** (default false until E2E-2 flips it)
KYRO_ADMIN_MFA_ENFORCED=true
# base64 of 32 random bytes; required outside local/test (profile "local" has a dev-only key)
KYRO_MFA_ENCRYPTION_KEY=
# How often an existing session is re-checked against the database
KYRO_SESSION_REVALIDATE_INTERVAL=60s
# Master switch and per-minute limits for the config-driven rate limiter
KYRO_RATE_LIMITS_ENABLED=true
KYRO_RATE_DISCOVERY_READ=120
KYRO_RATE_FUNDING_SUMMARY=120
KYRO_RATE_SWIPE=60
KYRO_RATE_PLEDGE=10
KYRO_RATE_PLEDGE_CANCEL=10
KYRO_RATE_REPORT=5
KYRO_RATE_PASSWORD_RESET=3
KYRO_RATE_PASSWORD_RESET_CONFIRM=10
KYRO_RATE_PASSWORD_CHANGE=5
KYRO_RATE_MFA_VERIFY=5
KYRO_RATE_MFA_ENROLL=5
KYRO_RATE_UPLOAD_URL=20
KYRO_RATE_VIEW_URL=30
# none locally; "native" behind a load balancer that sends X-Forwarded-For
KYRO_FORWARD_HEADERS_STRATEGY=none

# --- Web (3000) and Admin (3001): server-side only, used by Next rewrites ---
KYRO_API_ORIGIN=http://localhost:8080
